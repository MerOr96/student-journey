generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AppRole {
  APPLICANT
  STUDENT
}

enum Language {
  RU
  TK
}

enum DocumentType {
  PASSPORT
  PHOTO
  DIPLOMA
  MEDICAL
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatRole {
  USER
  ASSISTANT
}



model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String
  fullName       String
  phone          String?
  avatarUrl      String?
  birthDate      DateTime?
  velayat        String?
  role              UserRole  @default(USER)
  appRole           AppRole   @default(APPLICANT)
  applicationStatus String    @default("NEW")
  language          Language  @default(RU)
  crmApplicantId    Int?
  crmStudentId      Int?
  chosenFacultyId   Int?
  chosenFacultyName String?
  chosenSpecialtyId Int?
  chosenSpecialtyName String?
  pushToken      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile              PlayerProfile?
  quests               QuestCompletion[]
  badges               Badge[]
  documents            UserDocument[]
  chatMessages         ChatMessage[]
  liveMessages         LiveMessage[]
  notificationReads    NotificationRead[]

  @@index([email])
}

model PlayerProfile {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @unique @db.Uuid
  xp            Int    @default(0)
  level         String @default("beginner")
  referralCode  String @unique
  referralCount Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  questSlug   String
  xpAwarded   Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questSlug])
  @@index([userId])
}

model Badge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  badgeSlug String
  earnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeSlug])
  @@index([userId])
}

model UserDocument {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  type       DocumentType
  fileName   String
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?
  reviewNote String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Прямой чат студента с куратором
model LiveMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  fromUser  Boolean  // true = студент, false = куратор
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}


model NotificationRead {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  djangoNotifId Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, djangoNotifId])
}
